# OmniCore MCP 环境变量配置
# 复制此文件为 .env，填入你的 API key

# ── Agnes (Sapiens AI) — 生图 / 视频 / 识图主路径 ──────────────────────────
# 申请：https://agnes-ai.com/
AGNES_API_KEY=

# 可选：备用 key（主 key 失败时自动切换）
AGNES_API_KEY_FALLBACK=

# ── Doubao (火山引擎) — 识图/视频 Seed-2.0-mini、bbox/ASR Seed-2.1-lite、生图 Seedream-5.0-pro ─
# 申请：https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=

# ── MiMo (小米) — TTS / 识图 fallback ──────────────────────────────────────
# 申请：https://www.xiaomimimo.com/
MIMO_API_KEY=
# 可选，默认 https://token-plan-cn.xiaomimimo.com
# MIMO_API_HOST=https://token-plan-cn.xiaomimimo.com

# ── MiniMax — 全功能兜底（付费）────────────────────────────────────────────
# 申请：https://platform.minimaxi.com/
MINIMAX_API_KEY=

# ── StepFun — 生图 fallback（免费额度）─────────────────────────────────────
# 申请：https://www.stepfun.com/
STEPFUN_API_KEY=

# ── SenseNova (商汤) — 信息图生图 ──────────────────────────────────────────
# 申请：https://www.sensenova.cn/
SENSENOVA_API_KEY=

# ── Grok Imagine（经 aiproxy，不直连 x.ai）────────────────────────────────
# OmniCore image_gen/video_gen provider=grok 时使用
# AIPROXY_BASE_URL：Kuma 本机 http://127.0.0.1:8443；远程 CC 用 http://<kuma-ip>:8443
# AIPROXY_API_KEY：aiproxy 用户 token（与 CC providers.json aiproxy.authToken 相同）
AIPROXY_BASE_URL=http://127.0.0.1:8443
AIPROXY_API_KEY=

# ── DeepSeek 应用 API（OCR / ASR / TTS，2026-11-13 开放）──────────────────
# ocr_recognize 的唯一通道；transcribe_audio / voice_gen 的队尾兜底
# 申请：https://platform.deepseek.com/api_keys
# 可选：覆盖端点（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
